{
  "name": "enzocipher-site-react",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "update:repos": "node scripts/update-repos.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "preact": "^10.29.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "preact-router": "^4.1.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.9",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
